{% extends "layout_default.html.twig" %}

{% set active_menu = 'extensions' %}
{% set can_manage = has_permission('customcss', 'manage') %}
{% set editor = admin.customcss_get_css %}

{% block meta_title %}{{ 'Custom CSS'|trans }}{% endblock %}

{% block breadcrumbs %}
<ul class="breadcrumb">
    <li class="breadcrumb-item">
        <svg class="icon">
            <use href="#home" />
        </svg>
    </li>
    <li class="breadcrumb-item active" aria-current="page">{{ 'Custom CSS'|trans }}</li>
</ul>
{% endblock %}

{% block content %}
<div class="card">
    <div class="card-header">
        <h3 class="card-title">{{ 'Custom CSS'|trans }}</h3>
    </div>
    <div class="card-body">
        {% if not editor.writable %}
            <div class="alert alert-warning" role="alert">{{ 'modules/Customcss/custom.css is not writable by the web server user, so changes cannot be saved. Fix the file owner or permissions, or edit the file directly.'|trans }}</div>
        {% endif %}

        <p class="text-muted">{{ 'Loaded on every client area page after the Palisade theme, so rules with the same specificity win. Stored in modules/Customcss/custom.css, which updates never touch.'|trans }}</p>

        <form id="customcss-form" novalidate data-text-saved="{{ 'Saved. Invalidate the cache under System, Settings, System, Cache if the client area still shows the old styles.'|trans }}">
            <fieldset{% if not can_manage or not editor.writable %} disabled{% endif %}>
                <label class="form-label visually-hidden" for="customcss-css">{{ 'CSS'|trans }}</label>
                <textarea class="form-control font-monospace" id="customcss-css" name="css" rows="24" spellcheck="false" autocomplete="off" style="tab-size: 4; white-space: pre;">{{ editor.css }}</textarea>
                {% if can_manage %}
                    <div class="mt-3">
                        <button class="btn btn-primary" type="submit">{{ 'Save'|trans }}</button>
                    </div>
                {% endif %}
            </fieldset>
        </form>
    </div>
</div>
{% endblock %}

{% block js %}
{% if can_manage and editor.writable %}
<script nonce="{{ csp_nonce }}">
    (() => {
        const form = document.getElementById('customcss-form');
        const css = form.elements.css;
        let dirty = false;

        form.addEventListener('input', () => { dirty = true; });
        window.addEventListener('beforeunload', (event) => {
            if (dirty) {
                event.preventDefault();
                event.returnValue = '';
            }
        });

        form.addEventListener('submit', (event) => {
            event.preventDefault();
            ClientFence.api.admin.post('customcss/save', { css: css.value }, () => {
                dirty = false;
                ClientFence.message(form.dataset.textSaved, 'success');
            }, (error) => {
                ClientFence.message(error.message, 'error');
            });
        });
    })();
</script>
{% endif %}
{% endblock %}
